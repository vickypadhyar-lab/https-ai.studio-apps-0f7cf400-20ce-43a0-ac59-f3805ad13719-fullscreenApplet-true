rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isVerified() { return request.auth.token.email_verified == true; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // --- USER PROFILE RULES ---
    function isValidUser(data) {
      return data.id is string && 
             data.name is string && data.name.size() > 0 && data.name.size() <= 32 &&
             data.starPoints is number &&
             data.giftsSent is number;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.starPoints > 0; // Public rankings only
      allow create: if isOwner(userId) && 
                      isValidUser(incoming()) && 
                      incoming().starPoints == 0; // New users start at 0
      allow update: if isOwner(userId) && 
                      isValidUser(incoming()) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar', 'updatedAt']) &&
                      incoming().starPoints == existing().starPoints; // Protect ranking pts
    }

    // --- ROOM RULES ---
    function isValidRoom(data) {
      return data.id is string && data.title is string && data.title.size() <= 100 &&
             data.type in ['voice', 'stream'] && 
             data.hostId is string &&
             data.viewerCount is number;
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isVerified() && 
                      isValidRoom(incoming()) && 
                      incoming().hostId == request.auth.uid;
      allow update: if isSignedIn() && (
                      // Action: Host Updates
                      (isOwner(existing().hostId) && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'isLive', 'pkBattleId'])) ||
                      // Action: Join/Leave (System-like update)
                      (incoming().diff(existing()).affectedKeys().hasOnly(['viewerCount']))
                    );
      allow delete: if isOwner(existing().hostId);
    }

    // --- MESSAGE RULES ---
    function isValidMessage(data) {
      return data.id is string && 
             data.userId == request.auth.uid &&
             data.text is string && data.text.size() <= 500 &&
             data.timestamp is number;
    }

    match /rooms/{roomId}/messages/{messageId} {
      allow list: if isSignedIn();
      allow create: if isSignedIn() && 
                      get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId != null &&
                      isValidMessage(incoming());
    }

    // --- BATTLE RULES ---
    function isValidBattle(data) {
      return data.id is string && 
             data.scoreA is number && data.scoreB is number &&
             data.expiresAt > request.time.toMillis();
    }

    match /battles/{battleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isVerified();
      allow update: if isSignedIn() && 
                      isValidBattle(incoming()) &&
                      // Prevent changing room associations
                      incoming().roomAId == existing().roomAId &&
                      incoming().roomBId == existing().roomBId &&
                      // Ensure scores only go UP
                      incoming().scoreA >= existing().scoreA &&
                      incoming().scoreB >= existing().scoreB;
    }
  }
}
